 					INT32 nPalette = nTile & 0xF000;
@@ -140,3 +168,10 @@ INT32 NeoRenderText()
 						pTilePalette = &pTextPalette[nPalette >> 8];
-						RenderTile();
+						if (newtworldHud) {
+                            newtworldCells[(y-2)*40+x]=(UINT32)((pTextROM-NeoTextROMCurrent)/32+nTile)|((nPalette>>12)<<16);
+                            // Suppress HUD glyphs only, never transition masks or scenery.
