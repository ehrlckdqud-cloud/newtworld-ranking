-				UINT32 nTile = pTileRow[x << 5];
+				
+                    UINT32 nTile = newtworldCreditTile(x,y,pTileRow[x << 5],pTileRow);
 				INT32 nPalette = nTile & 0xF000;
@@ -166,3 +202,10 @@ INT32 NeoRenderText()
 					pTilePalette = &pTextPalette[nPalette >> 8];
-					RenderTile();
+					if (newtworldHud) {
+                            newtworldCells[(y-2)*40+x]=(UINT32)((pTextROM-NeoTextROMCurrent)/32+nTile)|((nPalette>>12)<<16);
+                            // Suppress HUD glyphs only, never transition masks or scenery.
+                            unsigned tile=(unsigned)((pTextROM-NeoTextROMCurrent)/32+nTile);
+                            if (y < 6 && ((tile>=0x800 && tile<=0x83f) || (newtworldHud==1 && ((tile>=0x300 && tile<=0x39f) || (tile>=0xba0 && tile<=0xbc7))))) continue;
