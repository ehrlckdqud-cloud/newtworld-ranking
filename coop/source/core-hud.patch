@@ -1,2 +1,13 @@
 #include "neogeo.h"
+static int newtworldHud=0, newtworldCredits=-1;
+extern "C" void retro_newtworld_credits(int value) { newtworldCredits=value; }
+// Change only the original CREDIT number cells; retain the game's tiles, palette and position.
+static UINT32 newtworldCreditTile(int x,int y,UINT32 tile,const UINT16* row) {
+ if(newtworldCredits<0 || y!=29 || x<33 || x>36 || (row[27<<5]&0xfff)!=0x343 || (row[32<<5]&0xfff)!=0x354) return tile;
+ unsigned value=(unsigned)newtworldCredits;
+ unsigned divisor=x==33?1000:x==34?100:x==35?10:1;
+ if(x<35 && value<divisor) return tile;
+ return (tile&0xf000)|0x330|((value/divisor)%10);
+}
+extern "C" void retro_set_newtworld_hud(int enabled) { newtworldHud=enabled; }
 
@@ -9,2 +20,9 @@ bool bBIOSTextROMEnabled;
 static UINT8* NeoTextROMCurrent;
+static UINT32 newtworldCells[1120];
+extern "C" unsigned retro_newtworld_cell(int x,int y) { return (x>=0&&x<40&&y>=0&&y<28)?newtworldCells[y*40+x]:0; }
+extern "C" void retro_newtworld_glyph(unsigned tile,unsigned pal,UINT32* out) {
+ if (!NeoTextROMCurrent || tile*32+32>(unsigned)nNeoTextROMSize[nNeoActiveSlot] || pal>255) return;
+ UINT8* data=NeoTextROMCurrent+tile*32;
+ for(int i=0;i<64;i++){unsigned c=(i&1)?(data[i/2]&15):(data[i/2]>>4);out[i]=c?(0xff000000|NeoPalette[pal*16+c]):0;}
+}
 
